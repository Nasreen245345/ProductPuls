# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://productpulse:productpulse_dev_pw@localhost:5432/productpulse_db

# --- Auth (used starting Module 1) ---
JWT_SECRET=change-me-to-a-random-64-character-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- App ---
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# --- AI provider (used starting Module 4) ---
AI_API_KEY=
